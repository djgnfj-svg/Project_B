shader_type canvas_item;
// 폴리지 상시 바람 — 밑동은 못 박히고 위로 갈수록 수평으로 밀린다.
//
// 🔴 **회전(`Sprite2D.rotation`)이 아니라 수평 시어인 이유 = 픽셀아트다.** 각도로 흔들면 각이
//   연속값이라 매 프레임 리샘플 결과가 달라져 **나무 테두리가 끓는다**(2026-08-01 실기 확대에서
//   확인 — 원본은 깔끔한 계단인데 화면에서는 윤곽이 지글거렸다). 시어는 x만 건드리므로
//   가로 방향 픽셀 줄이 통째로 보존되고, 세로 윤곽만 계단식으로 밀린다.
// 🔴 **`vertex()`이지 `fragment()`가 아니다** — UV를 밀면 캔버스 밖을 참조해 **우듬지가 잘린다**.
//   장식 PNG의 좌우 여백은 5px뿐인데 상시 바람만 해도 우듬지가 ~11px, 통과 반응이면 26px 움직인다.
//   정점을 옮기면 쿼드 자체가 따라가므로 잘릴 일이 원리적으로 없다.
// ⚠ `fragment()`를 건드리지 않으므로 rules §2의 "COLOR를 직접 곱하라"는 해당 없다 —
//   기본 렌더가 그대로 돌아 `modulate` 페이드가 정상 동작한다. fragment를 여기 추가한다면
//   그 규약을 먼저 읽어라.
// ⚠ 이 머티리얼은 **상시 부착**이다(rules §5의 "효과가 끝나면 material=null"의 예외).
//   판단 기준은 "평상시에도 렌더되는가"이고 — 폴리지는 늘 화면에 있다 — `sway_px = 0`이
//   `VERTEX.x += 0`이라 **산술적으로 항등**이라 끌 상태 자체가 없다.

uniform float sway_px = 0.0;  // 맨 윗줄이 밀리는 거리(px). 밑동(UV.y = 1)은 항상 0.

void vertex() {
	VERTEX.x += sway_px * (1.0 - UV.y);
}
