[node name="Gate" type="Area2D" parent="."]
y_sort_enabled = true
position = Vector2(882, 270)
collision_layer = 64
collision_mask = 2

; 🔴 **발 라인(월드 y=294)은 문을 48 → 96px로 키운 뒤에도 그대로다** (2026-08-02).
;   `position`은 손대지 않고 `offset`만 −24 → −48(= −캔버스 절반)로 바꿔서 유지했다 — 그래야
;   y_sort 키(= 아트 바닥)와 상호작용 위치가 옛 문과 같은 자리에 남는다. 둘 중 하나만 바꾸면
;   문이 길 위로 떠 보이거나 캐릭터가 문 앞뒤로 잘못 겹친다.
[node name="Sprite" type="Sprite2D" parent="Gate"]
position = Vector2(0, 24)
offset = Vector2(0, -48)
texture = ExtResource("3")

[node name="Collision" type="CollisionShape2D" parent="Gate"]
shape = SubResource("shape_gate")

; 안내 라벨 — 문이 위로 72px 뻗었으므로 그 위로 올린다(안 올리면 상인방·깃발에 겹쳐 안 읽힌다).
; ⚠ 좌우도 대칭으로 고쳤다 — 옛 값(−170..30)은 중심이 −70이라 글자가 문 왼쪽으로 치우쳐 있었다.
