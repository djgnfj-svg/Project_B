[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://src/player/player.gd" id="1"]
[ext_resource type="SpriteFrames" path="res://assets/sprites/player/warrior_white_frames.tres" id="2"]
[ext_resource type="Resource" path="res://data/jobs/warrior.tres" id="3"]
[ext_resource type="Script" path="res://src/combat/health_component.gd" id="5"]
[ext_resource type="Script" path="res://src/feel/camera_rig.gd" id="6"]
[ext_resource type="Texture2D" path="res://assets/sprites/fx/shadow.png" id="7"]
[ext_resource type="Texture2D" path="res://assets/sprites/fx/dust.png" id="8"]

[sub_resource type="RectangleShape2D" id="shape_body"]
size = Vector2(12, 12)

[node name="Player" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1")
job = ExtResource("3")

; ⚠ 여기 `sprite_frames`는 **에디터 미리보기/폴백**이다 — 런타임 진실원은 `data/jobs/*.tres`의
;   `frames`이고 `player.set_job()`이 덮어쓴다. 그래도 `warrior.tres`와 **같은 시트**를 물려 둔다:
;   갈라져 있으면 에디터에서 옛 그림을 보며 새 그림을 튜닝하게 된다.
; 🔴 `animation`/`autoplay`는 위 시트의 클립 이름과 **수동 미러**다 — 새 시트엔 무접미사 `idle`이
;   없어 `"idle"`로 두면 씬 로드 때 조용히 아무 클립도 안 걸린다(rules §5 「autoplay를 grep해 대조」).
;   ⚠ 이 미러는 트립와이어가 못 잡는다(`.tscn`은 `tests/test_player_anim_auto.gd`의 대상 밖) —
;   시트의 클립 이름을 바꾸면 여기도 같이 고쳐라.
[node name="Sprite" type="AnimatedSprite2D" parent="."]
z_index = 1
sprite_frames = ExtResource("2")
animation = &"idle_e"
autoplay = "idle_e"

[node name="WeaponPivot" type="Node2D" parent="."]
position = Vector2(0, -4)

[node name="Weapon" type="Sprite2D" parent="WeaponPivot"]
centered = false

[node name="ChargeOrb" type="Sprite2D" parent="."]
z_index = 2
visible = false

; 칼날 폭 리본 (2026-08-01) — 칼끝 궤적과 칼밑 궤적 **사이**를 채우는 면.
; 🔴 Line2D였을 땐 칼끝 한 점만 이어 7px 선이었다(사용자: "리본도 칼날에 맞게 두꺼웠으면"). 폭을
;   Line2D의 `width`로 키우면 안 된다 — 그 폭은 **선 진행 방향의 수직**이라 찌르기(창)에서 칼 옆으로
;   퍼진다. 면이면 두 변이 각각 칼끝·칼밑이라 어떤 모션에서도 칼 안에 머문다.
; ⚠ 꼬리 페이드·폭 감쇠는 이제 `player.gd`의 `TRAIL_*` const가 정본이다 — 면은 정점 색을 직접
;   넣어야 해서 Line2D의 `gradient`/`width_curve`를 쓸 수 없다.
[node name="SwingTrail" type="Polygon2D" parent="."]
top_level = true
z_index = 3
visible = false

[node name="Collision" type="CollisionShape2D" parent="."]
shape = SubResource("shape_body")

[node name="Health" type="Node" parent="."]
script = ExtResource("5")

[node name="Camera" type="Camera2D" parent="."]
enabled = false
script = ExtResource("6")

[node name="Shadow" type="Sprite2D" parent="."]
z_index = -2
position = Vector2(0, 13)
texture = ExtResource("7")

[node name="Dust" type="CPUParticles2D" parent="."]
position = Vector2(0, 14)
emitting = false
amount = 12
lifetime = 0.45
local_coords = false
texture = ExtResource("8")
direction = Vector2(0, -1)
spread = 55.0
gravity = Vector2(0, 24)
initial_velocity_min = 8.0
initial_velocity_max = 20.0
scale_amount_min = 0.6
scale_amount_max = 1.0
damping_min = 8.0
damping_max = 16.0
color = Color(1, 1, 1, 0.85)
